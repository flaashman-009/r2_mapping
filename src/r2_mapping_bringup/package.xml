<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r2_mapping_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch files, parameters and RViz configs for Yahboom R2 2D mapping and
    localization (slam_toolbox + Nav2 AMCL).
  </description>
  <maintainer email="jetson@yahboom.local">R2 Mapping</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>

  <exec_depend>r2_mapping_perception</exec_depend>
  <exec_depend>r2_mapping_tools</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

